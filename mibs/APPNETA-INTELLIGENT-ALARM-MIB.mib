		monitoringPolicyGroupName, alarmEventTimestamp, providerLink,
		alarmTags, alarmNetworkPathId32, alarmMonitoringPointId32,
		fieldNineTarget }
	STATUS     current
	DESCRIPTION "A trap to indicate that an AppNeta Intelligent Alarm in the ConnectError rule family has been cleared."
	::= { apnNotifBranch 91 }

